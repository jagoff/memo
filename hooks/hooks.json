{
  "description": "memo ambient memory hooks — proactive recall on every UserPromptSubmit, passive auto-capture on Stop, prewarm on SessionStart for fast cold-load, session snapshots so closed/crashed sessions can be resumed, and El Briefing (open loops + memory of the day) at startup. Every command is prefixed with MEMO_NONINTERACTIVE=1 so the first-run picker never fires inside a hook.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "MEMO_NONINTERACTIVE=1 memo prewarm",
            "timeout": 30,
            "async": true,
            "statusMessage": "memo: warming MLX models…"
          },
          {
            "type": "command",
            "command": "MEMO_NONINTERACTIVE=1 memo recall-daemon start",
            "timeout": 5,
            "async": true,
            "statusMessage": "memo: starting recall daemon…"
          },
          {
            "type": "command",
            "command": "MEMO_NONINTERACTIVE=1 memo session recent",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "MEMO_NONINTERACTIVE=1 memo briefing",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "MEMO_NONINTERACTIVE=1 memo recall-hook",
            "timeout": 8
          },
          {
            "type": "command",
            "command": "MEMO_NONINTERACTIVE=1 memo session autosave",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "MEMO_NONINTERACTIVE=1 memo session checkpoint",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "MEMO_NONINTERACTIVE=1 memo capture-stop",
            "timeout": 30,
            "async": true
          },
          {
            "type": "command",
            "command": "MEMO_NONINTERACTIVE=1 memo session checkpoint",
            "timeout": 5,
            "async": true
          },
          {
            "type": "command",
            "command": "MEMO_NONINTERACTIVE=1 memo session refresh-summary",
            "timeout": 20,
            "async": true,
            "statusMessage": "memo: actualizando resumen de sesión…"
          }
        ]
      }
    ]
  }
}
