{
  "description": "memo ambient memory hooks — proactive recall on every UserPromptSubmit, passive auto-capture on Stop, prewarm on SessionStart for fast cold-load, session snapshots so closed/crashed sessions can be resumed. Every command is prefixed with MEMO_NONINTERACTIVE=1 so the first-run picker never fires inside a hook (the picker would block waiting for stdin and exhaust the hook's timeout).",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "MEMO_NONINTERACTIVE=1 memo prewarm",
            "timeout": 30,
            "async": true,
            "statusMessage": "memo: warming MLX models…"
          }
        ]
      },
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "MEMO_NONINTERACTIVE=1 memo session recent --limit 5",
            "timeout": 3
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "MEMO_NONINTERACTIVE=1 memo recall-hook",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "MEMO_NONINTERACTIVE=1 memo capture-stop",
            "timeout": 30,
            "async": true
          },
          {
            "type": "command",
            "command": "MEMO_NONINTERACTIVE=1 memo session checkpoint",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ]
  }
}
