/* Console-style: one flat surface, no background bands, thin rules,
   text-like actions. Single accent (#61c7d7), semantic colours only. */

Screen {
    background: #101418;
    color: #e8edf2;
}

#config-center {
    width: 100%;
    height: 100%;
}

#config-header {
    height: 1;
    padding: 0 1;
    align: left middle;
}

#config-title {
    width: auto;
    color: #61c7d7;
    text-style: bold;
}

#config-context {
    width: 1fr;
    padding-left: 2;
    color: #697781;
}

#config-toolbar {
    height: 1;
    margin-top: 1;
    padding: 0 1;
    align: left middle;
}

#setting-search {
    width: 1fr;
    max-width: 64;
}

#advanced-label {
    width: auto;
    padding: 0 1 0 2;
    color: #9eabb5;
}

#show-advanced {
    width: 8;
    height: 1;
    border: none;
    background: transparent;
}

#domain-select {
    display: none;
    width: 24;
    margin-left: 1;
}

#workspace {
    height: 1fr;
    margin-top: 1;
}

#domain-nav {
    width: 18;
    height: 100%;
    padding: 0 1;
    border-right: solid #2a343c;
}

.domain-button {
    width: 100%;
    min-width: 0;
    height: 1;
    margin: 0;
    border: none;
    background: transparent;
    color: #9eabb5;
    text-align: left;
    content-align: left middle;
}

.domain-button:hover {
    background: transparent;
    color: #e8edf2;
}

.domain-active,
.domain-active:hover {
    background: transparent;
    color: #61c7d7;
    text-style: bold;
}

#settings-list {
    width: 1fr;
    height: 100%;
    padding: 0 1;
}

.setting-row {
    width: 100%;
    height: auto;
    padding: 0 1;
    margin-bottom: 1;
}

.setting-line {
    width: 100%;
    height: auto;
    align: left top;
}

.setting-copy {
    width: 1fr;
    height: auto;
}

.setting-label {
    height: 1;
    text-style: bold;
    color: #e8edf2;
}

.setting-description {
    height: 1;
    color: #9eabb5;
    text-overflow: ellipsis;
}

.setting-key {
    height: 1;
    color: #697781;
}

.setting-meta {
    width: 34;
    height: auto;
    align: right top;
}

.source-badge {
    width: 9;
    height: 1;
    margin-right: 1;
    text-align: center;
    color: #9eabb5;
}

.source-env {
    color: #e3b85b;
    text-style: bold;
}

.source-markdown {
    color: #66c989;
}

.source-overlay,
.source-derived {
    color: #61c7d7;
}

.setting-control {
    width: 22;
}

Switch.setting-control {
    width: auto;
    height: 1;
    border: none;
    background: transparent;
}

.setting-issue {
    height: auto;
    color: #ef6f72;
    text-overflow: ellipsis;
}

.has-error {
    border-left: solid #ef6f72;
}

#config-footer {
    height: 2;
    padding: 0 1;
    border-top: solid #2a343c;
    align: left middle;
}

#validation-summary {
    width: 1fr;
    color: #66c989;
}

#validation-summary.summary-error {
    color: #ef6f72;
    text-style: bold;
}

#pending-summary {
    width: 12;
    color: #9eabb5;
}

#discard-draft,
#review-draft {
    width: auto;
    min-width: 10;
    height: 1;
    margin-left: 2;
    border: none;
    background: transparent;
    color: #9eabb5;
}

#discard-draft:hover,
#review-draft:hover {
    background: transparent;
    color: #e8edf2;
}

#review-draft {
    color: #61c7d7;
    text-style: bold;
}

#empty-settings {
    padding: 2;
    color: #9eabb5;
}

#size-warning {
    display: none;
    width: 100%;
    height: 100%;
    content-align: center middle;
    color: #e3b85b;
    text-style: bold;
}

Screen.narrow #domain-nav {
    display: none;
}

Screen.narrow #domain-select {
    display: block;
}

Screen.narrow .setting-row {
    height: auto;
}

Screen.narrow .setting-line {
    height: auto;
    layout: vertical;
}

Screen.narrow .setting-copy {
    width: 100%;
    height: auto;
}

Screen.narrow .setting-meta {
    width: 100%;
    height: auto;
    align: right top;
}

FirstRunWizard,
ReviewScreen,
ConflictScreen,
RecoveryScreen,
ApplyResultScreen {
    align: center middle;
    background: #080a0c 75%;
}

.screen-panel {
    width: 88%;
    max-width: 110;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    background: #101418;
    border: solid #33404a;
}

.wizard-panel {
    width: 72;
    min-height: 22;
}

.review-panel,
.recovery-panel {
    height: 80%;
}

.conflict-panel,
.result-panel {
    min-height: 14;
}

.screen-title {
    height: 2;
    color: #61c7d7;
    text-style: bold;
}

#wizard-progress {
    height: 2;
    color: #9eabb5;
}

.screen-note {
    height: auto;
    min-height: 3;
    color: #9eabb5;
}

#wizard-body {
    height: 1fr;
    padding: 1 0;
}

#wizard-body Input,
#wizard-body Select {
    margin-bottom: 1;
}

.screen-actions {
    height: 1;
    align: right middle;
}

.screen-actions Button {
    width: auto;
    min-width: 12;
    height: 1;
    margin-left: 2;
    border: none;
    background: transparent;
    color: #9eabb5;
}

.screen-actions Button:hover {
    background: transparent;
    color: #e8edf2;
}

.screen-actions Button.-primary {
    color: #61c7d7;
    text-style: bold;
}

#review-changes,
#recovery-issues {
    height: 1fr;
    border-top: solid #2a343c;
    border-bottom: solid #2a343c;
    padding: 1;
}

.review-change,
.recovery-issue {
    height: auto;
    min-height: 3;
    margin-bottom: 1;
}

.review-section {
    height: 2;
    color: #e3b85b;
    text-style: bold;
}

.result-error {
    color: #ef6f72;
    text-style: bold;
}

Screen.narrow .screen-panel {
    width: 98%;
    height: 94%;
    padding: 1;
}
