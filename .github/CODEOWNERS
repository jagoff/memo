/src/memo/llm.py        @jagoff
/src/memo/memory/       @jagoff

# Markdown is the source of truth; sqlite is a rebuildable index.
/src/memo/store/        @jagoff

# Recall hook 5s budget.
/hooks/                 @jagoff
/src/memo/cli.py        @jagoff

# Retrieval-regression labels — every incident adds a prompt here.
/eval/                  @jagoff

