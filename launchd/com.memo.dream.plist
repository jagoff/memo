<?xml version="1.0" encoding="UTF-8"?>
<!--
  Template: nightly `memo dream run` LaunchAgent (macOS).
  Replace __HOME__ with your home directory (e.g. /Users/you) and __MEMO_BIN__
  with the absolute path to the `memo` binary (`command -v memo`), then:

    cp com.memo.dream.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.memo.dream.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.memo.dream</string>
  <key>ProgramArguments</key>
  <array>
    <string>__MEMO_BIN__</string>
    <string>dream</string>
    <string>if-due</string>
  </array>
  <!--
    Daily at 03:00 — after the midnight maintenance window, before morning
    sessions. On a laptop that sleeps overnight this fires on approximately
    none of those nights: measured on mac-black 2026-08-13, the machine was in
    darkwake at 03:02 and `launchctl print` reported `runs = 0` with the last
    dream.log entry three days old. macOS does not wake for a
    StartCalendarInterval and does not reliably replay the missed slot.

    So pair it with an hourly StartInterval and an idempotent entrypoint:
    `dream if-due` returns immediately unless >24h have passed since the last
    run (its own `.last_if_due_ts` stamp), and otherwise spawns `dream run`
    detached, so an hourly tick costs one short CLI start. The calendar entry
    still gives the preferred
    03:00 slot when the machine happens to be awake; the interval guarantees
    the pass is picked up within an hour of the machine next being awake.
  -->
  <!-- 03:30, not 03:00: com.memo.nightly owns 03:00 and both passes are
       MLX/GPU-heavy. Two concurrent cold model loads on one box is the
       documented exit-144 failure. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/memo/dream.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/memo/dream.err</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>MEMO_NONINTERACTIVE</key>
    <string>1</string>
    <!-- Self-improving recall tuner: min_sim + graph-weight (offline-gated + online-verified)
         and the online-only project-boost explorer. Every applied change is proven against
         real grounding and reverted if it regresses, so enabling by default is safe. -->
    <!-- MEMO_DREAM_FLAG_GRADUATION_ENABLED is absent on purpose: it has
         defaulted to ON since v4.3.0, so the graduation pass already runs.
         Set it to 0 here to turn it off. -->
    <key>MEMO_DREAM_TUNE_ENABLED</key>
    <string>1</string>
    <key>MEMO_DREAM_TUNE_BOOST_ENABLED</key>
    <string>1</string>
    <!-- Trust & belief-revision maintenance units (memo v3.0.0): mark mutually-
         contradicting durable memories `competing`, do N-way supersede over a
         shared trust margin, and calibrate the recall floor nightly. Read-mostly
         maintenance; measured in the dream receipt (`memo dream status`). -->
    <key>MEMO_BELIEF_COMPETING</key>
    <string>1</string>
    <key>MEMO_BELIEF_NWAY</key>
    <string>1</string>
    <key>MEMO_FLOOR_CALIBRATION</key>
    <string>1</string>
    <!-- Dream v2 self-improvement passes: pre-warm recurring unmet gaps + hot
         queries (anticipate), degree-normalized graph communities, and abstract
         recurring cross-session work into durable synthesis memories. -->
    <key>MEMO_DREAM_ANTICIPATE_ENABLED</key>
    <string>1</string>
    <key>MEMO_DREAM_COMMUNITIES_ENABLED</key>
    <string>1</string>
    <key>MEMO_DREAM_CONSOLIDATE_EPISODES_ENABLED</key>
    <string>1</string>
    <!-- Dream v2 self-improvement passes (batch 2026-08-03): nightly HyDE A/B
         (self-applying/self-reverting via the tuned overlay, gated on the
         curated eval set), MinHash-blocked LLM entity-dedup (bounded 30
         pairs/night), and grounded co-use edge-confidence curation
         (never touches recall ranking, never deletes). -->
    <key>MEMO_DREAM_HYDE_TUNE_ENABLED</key>
    <string>1</string>
    <key>MEMO_DREAM_ENTITY_CANON_ENABLED</key>
    <string>1</string>
    <key>MEMO_DREAM_EDGE_VERIFY_ENABLED</key>
    <string>1</string>
    <!-- Contradiction/support signals: capture tool evidence, weigh mutability in
         contradiction scans, require N supporting memories before supersede, and
         lift confidence per corroborating source. -->
    <key>MEMO_CAPTURE_TOOL_EVIDENCE</key>
    <string>1</string>
    <key>MEMO_CONTRADICT_MUTABILITY</key>
    <string>1</string>
    <key>MEMO_SUPERSEDE_SUPPORT_GATE</key>
    <string>3</string>
    <key>MEMO_SUPPORT_CONFIDENCE_LIFT</key>
    <string>0.1</string>
    <key>HF_HUB_OFFLINE</key>
    <string>1</string>
    <key>TRANSFORMERS_OFFLINE</key>
    <string>1</string>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
    <key>PATH</key>
    <string>__HOME__/.local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
</dict>
</plist>
